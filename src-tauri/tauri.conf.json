{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FADT",
  "version": "0.2.7",
  "identifier": "com.yon9e.excel-cell-summary-tool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FADT · Financial Audit Data Toolkit",
        "backgroundColor": "#0e1b2d",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../third_party/umi-ocr/runtime": "umi-ocr",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES": "THIRD_PARTY_LICENSES",
      "resources/list_quick_access.ps1": "list_quick_access.ps1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "resources/fadt-installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
